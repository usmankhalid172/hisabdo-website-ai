    "authorization_required": true,
    "financial_data_user_scoped": true,
    "prompt_injection_controls": true,
    "hide_internal_errors": true,
    "audit_logging": true
  },
  "future_improvements": [
    "knowledge_base_governance",
    "multilingual_evaluation_dataset",
    "intent_and_entity_improvements",
    "rag_quality_controls",
    "production_security",
