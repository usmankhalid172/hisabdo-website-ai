APP_NAME=HisabDo
ENVIRONMENT=development
DEBUG=true

API_HOST=0.0.0.0
API_PORT=8000
VITE_API_BASE_URL=http://localhost:8000

MONGODB_URI=mongodb://localhost:27017/hisabdo
MONGODB_DB=hisabdo

JWT_SECRET=CHANGE_THIS_IN_LOCAL_ENV
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

